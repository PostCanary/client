# Copy this file to .env.test.local. That destination is ignored by Git.
# Use a staging-only QA account and rotate it immediately if its password is exposed.
POSTCANARY_TEST_EMAIL=staging-qa@example.com
POSTCANARY_TEST_PASSWORD=replace-with-staging-only-secret

# Opt in only for suites that intentionally reset the shared demo profile,
# organization, and brand kit. Ordinary authenticated QA should leave this off.
POSTCANARY_TEST_SEED_DEMO=0

E2E_LIVE_BASE_URL=http://localhost:8080
